import time
import statistics
import json
from wrapper_api.schemas import BobProposalPayload
from sdga_kernel.expected_loss import SDGAExpectedLossEngine

def run_performance_benchmark(iterations: int = 1000):
    engine = SDGAExpectedLossEngine()
    
    # Sample High-Risk Payload
    payload_data = {
        "proposal_id": "BENCHMARK-PR-001",
        "repository": "core-kernel",
        "branch": "main",
        "files_changed_count": 12,
        "lines_added": 450,
        "lines_deleted": 300,
        "breaking_changes_detected": False,
        "test_coverage_delta": 0.02,
        "confidence_score": 0.88,
        "proposed_diff_summary": "Performance benchmark evaluation diff",
        "security_sensitive_module": True
    }
    
    payload = BobProposalPayload(**payload_data)
    latencies_ms = []

    # Warmup
    for _ in range(50):
        _ = engine.compute_decision(payload)

    # Benchmark Execution Loop
    for _ in range(iterations):
        start_time = time.perf_counter()
        _ = engine.compute_decision(payload)
        end_time = time.perf_counter()
        
        latency_ms = (end_time - start_time) * 1000.0
        latencies_ms.append(latency_ms)

    avg_latency = statistics.mean(latencies_ms)
