import numpy as np
from typing import Dict, Any

class SDGAExpectedLossEngine:
    """
    SDGA v6.0 Sovereign Kernel
    Integrates real Fourier Holographic Reduced Representation (FHRR) over complex 
    phase space (D=10,000) coupled with Expected Loss Optimization (L_action vs L_inaction).
    """
    def __init__(self, d_dimension: int = 10000, cost_matrix: Dict[str, float] = None):
        self.d_dimension = d_dimension
        self.cost_matrix = cost_matrix or {
            "act_fail_cost": 500.0,
            "act_success_benefit": 50.0,
            "inact_fail_cost": 800.0
        }
        # Create baseline complex reference vector z_base in C^D
        np.random.seed(42)
        baseline_phases = np.random.uniform(-np.pi, np.pi, self.d_dimension)
        self.z_base = np.exp(1j * baseline_phases)

    def generate_phase_vectors(self, payload: Any) -> np.ndarray:
        """
        Generates 10,000-D complex phase vector z_proposal = exp(j * phi_k)
        deterministically from proposal payload metrics.
        """
        # Deterministic seed from payload inputs
        payload_seed = hash((
            payload.proposal_id,
            payload.files_changed_count,
            payload.lines_added,
            payload.lines_deleted,
            payload.confidence_score
        )) % (2**32 - 1)

        np.random.seed(payload_seed)

        # Base phase perturbation bounded by diff magnitude
        scale = np.clip((payload.lines_added + payload.lines_deleted) / 1000.0, 0.1, np.pi)
        phi_k = np.random.uniform(-scale, scale, self.d_dimension)

        if payload.breaking_changes_detected:
            phi_k += np.pi / 2.0
        if payload.security_sensitive_module:
            phi_k += np.pi / 4.0

        # Complex FHRR Phase Vector Construction: z_k = exp(j * phi_k)
        z_proposal = np.exp(1j * phi_k)
        return z_proposal

    def compute_hermitian_stability(self, z_proposal: np.ndarray) -> float:
        """
        Computes normalized Hermitian inner product S_FHRR = (1/D) * |<z_base, z_proposal>|
        """
        inner_product = np.vdot(self.z_base, z_proposal)
        s_fhrr = float(np.abs(inner_product) / self.d_dimension)
        return float(np.clip(s_fhrr, 0.0, 1.0))

    def compute_decision(self, payload: Any) -> Dict[str, Any]:
        # 1. ACTUAL FHRR EXECUTION: Generate vector z_proposal and compute S_FHRR
        z_proposal = self.generate_phase_vectors(payload)
        s_fhrr = self.compute_hermitian_stability(z_proposal)

        # 2. Compute static penalties
        penalty = 0.0
        if payload.breaking_changes_detected:
            penalty += 0.25
        if payload.security_sensitive_module:
            penalty += 0.20
        if payload.test_coverage_delta < 0:
            penalty += abs(payload.test_coverage_delta) * 0.30

        # 3. ACTUAL MODULATION: P_success coupled with S_FHRR
        raw_p = payload.confidence_score - penalty
        p_success = float(np.clip(0.70 * raw_p + 0.30 * s_fhrr, 0.01, 0.99))
        p_fail = 1.0 - p_success

        # 4. Dynamic scaling for security modules
        gamma_dyn = 0.20 if payload.security_sensitive_module else 1.00

        # 5. Expected Loss Equations
        l_action = (p_fail * self.cost_matrix["act_fail_cost"]) - \
                   (p_success * self.cost_matrix["act_success_benefit"] * gamma_dyn)

        p_inaction_risk = 0.60 if payload.security_sensitive_module else 0.30
        l_inaction = p_inaction_risk * self.cost_matrix["inact_fail_cost"]

        # 6. Normalized Decision Index (RDE_norm)
        delta_l = l_inaction - l_action
        norm_factor = max(abs(l_action), abs(l_inaction), 1.0)
        rde_norm = float(np.clip(delta_l / norm_factor, -1.0, 1.0))

        # 7. Strict Gate Rules
        if payload.security_sensitive_module and p_success < 0.60:
            decision = "CRITICAL_ABORT"
            permitted = False
        elif l_action < 0 and rde_norm > 0.30:
            decision = "EXECUTE"
            permitted = True
        elif l_inaction > l_action:
            decision = "HUMAN_REFERRAL"
            permitted = False
        else:
            decision = "SAFE_ABORT"
            permitted = False

        return {
            "l_action": round(l_action, 4),
            "l_inaction": round(l_inaction, 4),
            "rde_norm": round(rde_norm, 4),
            "s_fhrr_stability": round(s_fhrr, 4),
            "d_dimension_used": self.d_dimension,
            "gamma_dynamic": gamma_dyn,
            "decision": decision,
            "execution_permitted": permitted
        }